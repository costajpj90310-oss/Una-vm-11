{
  "name": "Windows 11 no Codespaces",
  "dockerComposeFile": "docker-compose.yml",
  "service": "windows11",
  "shutdownAction": "none", 
  "forwardPorts": [8006],
  "portsAttributes": {
    "8006": {
      "label": "Interface do Windows 11",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": []
    }
  }
}
